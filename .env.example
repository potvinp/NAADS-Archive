# Copy to .env to use PostgreSQL instead of the default bundled SQLite file.
# Leave unset (or delete this file's copy) to keep using SQLite.
#DATABASE_URL=postgresql://user:password@localhost:5432/naads

# Force a specific backend regardless of the variables above.
#DB_CLIENT=postgres

# Other options (see README):
#PORT=3000
#ARCHIVE_POLL_MINUTES=15

# --- Live broadcast feed ---
# Attention tone played before broadcast-immediate alerts. Defaults to the
# bundled Tone-v2.mp3; set a path to override, or point it at a missing
# file to disable the tone.
#NAADS_ALERT_TONE=./audio/Tone-v2.mp3
# Which CAP <info> language block the broadcast feed prefers (prefix match).
#NAADS_BROADCAST_LANG=en
# Stored alert id replayed by the monitor's "Send test alert" button.
#NAADS_TEST_ALERT_ID=815048

# --- Continuous HLS alert channel (needs ffmpeg + ffprobe on PATH) ---
# Serves /hls/live.m3u8 and a /stream player page: a 24/7 program that loops
# a slate and splices in the on-air sequence + EMERGENCY ALERT card per alert.
#NAADS_STREAM=1
#NAADS_STREAM_SIZE=1280x720
#NAADS_STREAM_FPS=15
#NAADS_STREAM_SEGMENT_SECONDS=6
#NAADS_STREAM_WINDOW=24
# Segments to keep buffered ahead of real time (smooths jitter; raises latency).
#NAADS_STREAM_LOOKAHEAD_SEGMENTS=3
#NAADS_STREAM_MIN_ALERT_SECONDS=20
# Silent padding at both ends of an alert block (insurance against
# segment-boundary rounding on the HLS stream).
#NAADS_STREAM_LEAD_SILENCE=2.5
# On-air card text: long messages page onto extra cards. Min seconds each
# page is shown, and its wrap width / line count.
#NAADS_STREAM_PAGE_SECONDS=8
#NAADS_STREAM_PAGE_COLS=46
#NAADS_STREAM_PAGE_LINES=8
# Personal streams: reap an idle keyed channel after N minutes; cap live channels.
#NAADS_STREAM_IDLE_MINUTES=10
#NAADS_STREAM_MAX_CHANNELS=24
# Only air broadcast-immediate alerts on the stream.
#NAADS_STREAM_BI_ONLY=1
# Shared token for player access (VLC/OBS/hls.js can't send the session
# cookie). When auth is on and this is unset, only a logged-in session works.
#NAADS_STREAM_TOKEN=
# Fonts (auto-detected on most Linux; set if the stream logs "no usable font").
#NAADS_STREAM_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
#NAADS_STREAM_FONT_MONO=/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf

# --- Optional authentication (fully opt-in: unset = app is wide open) ---
#NAADS_AUTH=1
# Allow a no-credentials "Continue as guest" login (search only, no broadcast).
# On by default when NAADS_AUTH is set; set to 0 to disable.
#NAADS_GUEST=0
# Add the Secure flag to the session cookie (serve over HTTPS).
#NAADS_AUTH_SECURE=1
# Session lifetime in hours (default 720 = 30 days).
#NAADS_SESSION_TTL_HOURS=720
# One-time admin bootstrap when no accounts exist yet (headless/Docker).
#NAADS_ADMIN_USER=admin
#NAADS_ADMIN_PASS=change-me
